# Supabase — da compilare quando il progetto Supabase sarà creato.
# In locale: copia questo file in .env.local. Su Vercel: Project Settings → Environment Variables.
# Finché sono vuote l'app usa i dati finti di src/lib/mock-data.ts.
NEXT_PUBLIC_SUPABASE_URL=
# Chiave pubblica: va bene la anon (eyJ...) o la publishable (sb_publishable_...),
# con uno dei due nomi qui sotto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chiave segreta (sb_secret_... o service_role), SOLO sul server: mai con NEXT_PUBLIC_.
# Serve al recupero dell'email della tessera. Senza, il collegamento della tessera
# funziona come prima (codice mandato all'email scritta, senza riquadro).
SUPABASE_SECRET_KEY=
